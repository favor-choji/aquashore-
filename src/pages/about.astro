---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Stats from '../components/Stats.astro';
import Certifications from '../components/Certifications.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="About Us | Aquashore Marine">
  <Header />
  <section class="pt-24 bg-[#F4F7FB]">
    <div class="max-w-7xl mx-auto px-6 py-12 text-center">
      <span class="text-[#004E89] font-extrabold text-sm tracking-widest uppercase block mb-2">Our Story</span>
      <h1 class="text-5xl font-extrabold text-[#00043A] font-[Montserrat]">Nigeria's Premier Digital-First Safety Partner.</h1>
      <p class="text-[#002962] text-lg max-w-3xl mx-auto font-medium mt-4">Aquashore Marine Services Ltd. (RC 283321) was incorporated to provide world-class sales, servicing, and maintenance of Liferafts, Fire Safety Equipment, and Navigational Aids.</p>
    </div>

    <Stats />

    <div class="max-w-7xl mx-auto px-6 py-20">
      <div class="grid md:grid-cols-3 gap-6 auto-rows-[350px]">
        <div class="md:col-span-2 md:row-span-2 bg-[#001452] rounded-2xl border border-[#002962] shadow-xl overflow-hidden relative group transition-all hover:border-[#FCDD00]">
          <div class="absolute top-0 left-0 w-6 h-6 border-t-2 border-l-2 border-transparent group-hover:border-[#FCDD00] transition-colors duration-300 rounded-tl-sm pointer-events-none"></div>
          <div class="absolute top-0 right-0 w-6 h-6 border-t-2 border-r-2 border-transparent group-hover:border-[#FCDD00] transition-colors duration-300 rounded-tr-sm pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-6 h-6 border-b-2 border-l-2 border-transparent group-hover:border-[#FCDD00] transition-colors duration-300 rounded-bl-sm pointer-events-none"></div>
          <div class="absolute bottom-0 right-0 w-6 h-6 border-b-2 border-r-2 border-transparent group-hover:border-[#FCDD00] transition-colors duration-300 rounded-br-sm pointer-events-none"></div>
          
          <div class="h-[60%] overflow-hidden">
            <img src="/images/enclosed-lifeboat-launch.webp" alt="Lifeboat Testing" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-8">
            <span class="text-[#FCDD00] font-bold text-xs uppercase tracking-widest mb-2 block">Compliance & Training</span>
            <h3 class="text-2xl font-bold text-white mb-3 font-[Montserrat] group-hover:text-[#FCDD00] transition-colors">Fully Licensed & Internationally Recognized</h3>
            <p class="text-slate-300 text-sm group-hover:text-white transition-colors">We are fully licensed by the Federal Fire Service and recognized internationally by major safety equipment manufacturers. Our technicians are trained overseas to operate with the latest INTERNATIONAL SOLAS REGULATIONS.</p>
          </div>
        </div>

        <div class="bg-[#001452] rounded-2xl border border-[#002962] p-8 shadow-xl flex flex-col justify-center relative group transition-all hover:border-[#FCDD00]">
          <div class="absolute top-0 left-0 w-6 h-6 border-t-2 border-l-2 border-transparent group-hover:border-[#FCDD00] transition-colors duration-300 rounded-tl-sm pointer-events-none"></div>
          <div class="absolute top-0 right-0 w-6 h-6 border-t-2 border-r-2 border-transparent group-hover:border-[#FCDD00] transition-colors duration-300 rounded-tr-sm pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-6 h-6 border-b-2 border-l-2 border-transparent group-hover:border-[#FCDD00] transition-colors duration-300 rounded-bl-sm pointer-events-none"></div>
          <div class="absolute bottom-0 right-0 w-6 h-6 border-b-2 border-r-2 border-transparent group-hover:border-[#FCDD00] transition-colors duration-300 rounded-br-sm pointer-events-none"></div>

          <span class="text-[#FCDD00] font-bold text-xs uppercase tracking-widest mb-2 block">Global Partners</span>
          <h3 class="text-xl font-bold text-white mb-3 font-[Montserrat] group-hover:text-[#FCDD00] transition-colors">Authorized Agents</h3>
          <p class="text-slate-300 text-sm font-medium group-hover:text-white transition-colors">Dunlop Marine Safety Limited (UK), DSB, AUTOFLUG, and Shanghai Marine Equipment.</p>
        </div>

        <div class="bg-[#001452] rounded-2xl border border-[#002962] p-8 shadow-xl flex flex-col justify-center relative group transition-all hover:border-[#FCDD00]">
          <div class="absolute top-0 left-0 w-6 h-6 border-t-2 border-l-2 border-transparent group-hover:border-[#FCDD00] transition-colors duration-300 rounded-tl-sm pointer-events-none"></div>
          <div class="absolute top-0 right-0 w-6 h-6 border-t-2 border-r-2 border-transparent group-hover:border-[#FCDD00] transition-colors duration-300 rounded-tr-sm pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-6 h-6 border-b-2 border-l-2 border-transparent group-hover:border-[#FCDD00] transition-colors duration-300 rounded-bl-sm pointer-events-none"></div>
          <div class="absolute bottom-0 right-0 w-6 h-6 border-b-2 border-r-2 border-transparent group-hover:border-[#FCDD00] transition-colors duration-300 rounded-br-sm pointer-events-none"></div>

          <span class="text-[#FCDD00] font-bold text-xs uppercase tracking-widest mb-2 block">Coverage</span>
          <h3 class="text-xl font-bold text-white mb-3 font-[Montserrat] group-hover:text-[#FCDD00] transition-colors">Nationwide Ports</h3>
          <p class="text-slate-300 text-sm font-medium group-hover:text-white transition-colors">Representatives and rapid dispatch teams in Lagos, Warri, Port Harcourt, and Calabar.</p>
        </div>
      </div>
    </div>
  </section>
  <Certifications />
  <Footer />
</Layout>