---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Stats from '../components/Stats.astro';
import Services from '../components/Services.astro';
import Certifications from '../components/Certifications.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Services | Aquashore Marine">
  <Header />
  <div class="pt-24 bg-[#F4F7FB]">
    <div class="max-w-7xl mx-auto px-6 py-12 text-center">
      <span class="text-[#004E89] font-extrabold text-sm tracking-widest uppercase block mb-2">Our Expertise</span>
      <h1 class="text-5xl font-extrabold text-[#00043A] font-[Montserrat]">Marine Safety Operations</h1>
    </div>
    <Stats />
    <Services />
  </div>
  <Certifications />
  <Footer />
</Layout>