<div class="bg-[#EBF2FA] p-8 md:p-10 rounded-2xl shadow-sm border border-[#D0E4F5] relative group transition-all hover:border-[#FF002B]">
  
  <div class="absolute top-0 left-0 w-6 h-6 border-t-2 border-l-2 border-transparent group-hover:border-[#FF002B] transition-colors duration-300 rounded-tl-sm pointer-events-none"></div>
  <div class="absolute top-0 right-0 w-6 h-6 border-t-2 border-r-2 border-transparent group-hover:border-[#FF002B] transition-colors duration-300 rounded-tr-sm pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-6 h-6 border-b-2 border-l-2 border-transparent group-hover:border-[#FF002B] transition-colors duration-300 rounded-bl-sm pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-6 h-6 border-b-2 border-r-2 border-transparent group-hover:border-[#FF002B] transition-colors duration-300 rounded-br-sm pointer-events-none"></div>

  <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="flex flex-col gap-5 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <label class="block text-xs font-bold text-[#00043A] uppercase tracking-wider mb-2 group-hover:text-[#FF002B] transition-colors">Your Name</label>
        <input type="text" name="name" required class="w-full px-4 py-3 rounded-lg bg-white border border-[#B3D4F0] text-[#00043A] focus:outline-none focus:border-[#FF002B] focus:ring-2 focus:ring-[#FF002B]/20 transition-all" />
      </div>
      <div>
        <label class="block text-xs font-bold text-[#00043A] uppercase tracking-wider mb-2 group-hover:text-[#FF002B] transition-colors">Work Email</label>
        <input type="email" name="email" required class="w-full px-4 py-3 rounded-lg bg-white border border-[#B3D4F0] text-[#00043A] focus:outline-none focus:border-[#FF002B] focus:ring-2 focus:ring-[#FF002B]/20 transition-all" />
      </div>
    </div>
    <div>
      <label class="block text-xs font-bold text-[#00043A] uppercase tracking-wider mb-2 group-hover:text-[#FF002B] transition-colors">Vessel / Company Name</label>
      <input type="text" name="company" class="w-full px-4 py-3 rounded-lg bg-white border border-[#B3D4F0] text-[#00043A] focus:outline-none focus:border-[#FF002B] focus:ring-2 focus:ring-[#FF002B]/20 transition-all" />
    </div>
    <div>
      <label class="block text-xs font-bold text-[#00043A] uppercase tracking-wider mb-2 group-hover:text-[#FF002B] transition-colors">How can we assist your fleet?</label>
      <textarea name="message" rows="4" required class="w-full px-4 py-3 rounded-lg bg-white border border-[#B3D4F0] text-[#00043A] focus:outline-none focus:border-[#FF002B] focus:ring-2 focus:ring-[#FF002B]/20 transition-all"></textarea>
    </div>
    <button type="submit" class="w-full bg-[#FF002B] text-white px-8 py-4 rounded-lg font-bold text-sm tracking-wider uppercase hover:bg-[#C00021] transition-all shadow-lg shadow-red-500/30 mt-2">Send Message</button>
  </form>
</div>