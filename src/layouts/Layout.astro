---
import '../styles/global.css';
const { title = "Aquashore Marine Services Ltd" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Class-approved SOLAS marine safety services in Nigeria. Liferaft servicing, FFE, LSA, and rapid 24/7 dispatch in Lagos, Port Harcourt, Warri, and Calabar." />
    <meta name="theme-color" content="#F4F7FB" />
    <title>{title}</title>
    <link rel="icon" href="/images/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#F4F7FB] text-slate-800 font-[Inter] antialiased">
    <slot />
  </body>
</html>